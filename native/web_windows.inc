/* Deliver input to the firmware's own popup, preserving a suspended modal
   caller. Modeless shop windows must receive WM_CREATE, touch and WM_CLOSE. */
static ChildWindow parent_shop;
static int parent_shop_valid;
static CPU parent_notebook_cpu;
static int parent_notebook_valid;
static int web_battle_drawn;
static u32 web_notice_active,web_notice_return;
static u32 web_notice_pixels[190*20];
/* Capture the firmware's two menu entries while their stack descriptors live.
   Opening eligibility remains in 0x300cd6ec (owned item, adjacent staircase).
   Selection uses its normal 0x126 command; the ARM game owns bounds, floor
   changes, destination position, map persistence and item ownership. */
static int web_flight_create(u32 descriptors,u32 count){
 if(count!=2u)return 0;
 for(u32 row=0;row<2u;row++){
  u32 text=mr32(descriptors+row*16u);
  for(u32 i=0;i<47u;i++){web_flight_labels[row][i]=mr8(text+i);if(!web_flight_labels[row][i])break;}
  web_flight_labels[row][47]=0;
 }
 web_flight_prepared=1;return 1;
}
static int paint_web_flight(void){
 if(!web_flight_active)return 0;
 erase_pending=invalidated=0;clearfb();
 call_arm(emu_profile_current()->app_paint,WINDOW,0,0,0,700000);
 Obj*d=getobj(fb_dc);if(!d)return 1;
 Obj saved=*d;u32 font=new_handle(OBJ_FONT);Obj*f=getobj(font);
 if(f){f->width=8;f->height=16;d->selected_font=font;}
 d->origin_x=d->origin_y=0;d->bk_mode=1;
 fillrect(d,55,114,185,178,0x000000);fillrect(d,56,115,184,177,0xffffff);
 for(u32 row=0;row<2u;row++){
  int y=118+(int)row*28;u32 selected=row==web_flight_selection;
  fillrect(d,59,y,181,y+27,selected?0x000000:0xffffff);
  d->text_color=selected?0xffffff:0x000000;
  u32 length=0;while(length<47u&&web_flight_labels[row][length])length++;
  draw_text_bytes(d,74,y+5,web_flight_labels[row],length,0,0);
 }
 *d=saved;if(f)f->kind=0;return 1;
}
static int web_flight_choose(int cancel){
 u32 selection=web_flight_selection;web_flight_active=web_flight_prepared=0;
 if(!cancel){
  mw32(WEB_FLIGHT_MENU,0);mw32(WEB_FLIGHT_MENU+4u,selection);mw32(WEB_FLIGHT_MENU+8u,0);
  int ok=call_arm(emu_profile_current()->app_wndproc,WINDOW,0x126u,0,WEB_FLIGHT_MENU,900000);
  deliver_child();emu_paint();return ok!=0;
 }
 emu_paint();return 1;
}
static int web_flight_key(u32 key){
 if(key==27u)return web_flight_choose(1);
 if(key==41u)return web_flight_choose(0);
 if(key==38u||key==37u)web_flight_selection=0;
 if(key==40u||key==39u)web_flight_selection=1;
 emu_paint();return 1;
}
static int web_flight_touch(u32 x,u32 y){
 if(x<55u||x>=185u||y<114u||y>=178u)return web_flight_choose(1);
 web_flight_selection=y<146u?0u:1u;return web_flight_choose(0);
}
/* Capture the firmware's rendered status line when its message routine returns.
   Full host repaints otherwise erase it via the game's blank-line painter. */
static void web_notice_observe(u32 addr){
 /* The original movement event pass already handles stair arrivals. Flight,
    load and dialogue continuations can load a map without that event pass. */
 if(addr==0x300c4d40u||addr==0x300c4d98u)web_story_pending=1;
 /* Floor zero is generated by the original descending item (0x300cdbd8),
    outside the 50-map file. Restore that exact room after loading a save;
    never let its negative file offset overwrite the first-floor map. */
 if((addr==0x300c4d40u||addr==0x300c4d98u||addr==0x300c4dd8u)&&cpu.r[0]==WINDOW){
  u32 state=mr32(WINDOW+0x58u);
  if(state&&mr32(state+5u)==0u){
   if(addr!=0x300c4dd8u){
    for(u32 i=0;i<121u;i++)mw8(0x3047214cu+i,0);
    mw8(0x3047214cu,6u);
    if(!(mr32(state+0x3du)&0x4000u))mw8(0x3047214cu+60u,0x29u);
   }
   hret(0);return;
  }
 }
 if(addr==0x300cce4cu)web_story_pending=0;
 if(addr==0x300c7100u&&cpu.r[0]==WINDOW){web_notice_return=cpu.r[14];return;}
 if(!web_notice_return||addr!=web_notice_return)return;
 web_notice_return=0;web_notice_active=1;
 for(u32 y=0;y<20;y++)for(u32 x=0;x<190;x++)
  web_notice_pixels[y*190+x]=framebuffer[(300+y)*FB_W+x];
}
static void paint_web_notice(void){
 if(!web_notice_active||emu_mode()!=0||child.active)return;
 for(u32 y=0;y<20;y++)for(u32 x=0;x<190;x++)
  framebuffer[(300+y)*FB_W+x]=web_notice_pixels[y*190+x];
}
/* Combat is driven by the firmware's timer 2, separate from story sleeps. */
u32 web_combat_active(void){
 u32 state=mr32(WINDOW+0x58u);
 if(!state||emu_mode()!=0||mr32(state+0x1du)!=0)return 0;
 for(int i=0;i<MAX_TIMERS;i++)
  if(timers[i].active&&timers[i].window==WINDOW&&timers[i].id==2u)return 1;
 return 0;
}
static int paint_web_combat(void){
 if(!web_combat_active()){web_battle_drawn=0;return 0;}
 if(!web_battle_drawn){
  erase_pending=invalidated=0;clearfb();
  call_arm(emu_profile_current()->app_paint,WINDOW,0,0,0,700000);
  /* Show the original sword-strike sprite before the first combat tick.
     Even a one-hit victory gets a visible strike for its timer interval. */
  call_arm(0x300c5dccu,0x69u,WINDOW,0,0,300000);
  web_battle_drawn=1;
 }
 /* Later timer ticks already draw their own attack / recovery frames.
    A full map repaint here would erase them before the browser sees them. */
 return 1;
}
static void paint_shop_background(void){
 if(child.callback==0x300ce1ecu||child.callback==0x300cebbcu){
  fillrect(getobj(fb_dc),child.left,child.top,child.right,child.bottom,0xffffff);
  return;
 }
 if(!child.modeless||child.callback!=0x300c9294u)return;
 call_arm(emu_profile_current()->app_paint,WINDOW,0,0,0,700000);
 /* Let the firmware erase its own client area using its system colour.
    No Web palette, decorative border or selection overlay. */
 call_arm(child.callback,child.handle,0x14u,child.dc,0,500000);
}
static u32 notebook_records(void){u32 state=mr32(WINDOW+0x58u);return state?mr32(state+0x39u)&0x3fffffu:0;}
static void paint_notebook_selection(void){
 if(!child.active||child.callback!=0x300cebbcu)return;
 u32 records=notebook_records();if(!records)return;
 if(child.selection>=22u||!(records&(1u<<child.selection))){
  for(child.selection=0;child.selection<22u;child.selection++)if(records&(1u<<child.selection))break;
 }
 i32 x=child.left+3+(i32)(child.selection%5u)*31,y=child.top+3+(i32)(child.selection/5u)*17;
 Obj*d=getobj(fb_dc);line(d,x,y,x+28,y,0);line(d,x,y,x,y+14,0);
 line(d,x,y+14,x+28,y+14,0);line(d,x+28,y,x+28,y+14,0);
}
static int child_message(u32 message,u32 param,u32 point){
 if(!child.active)return 0;
 CPU saved=cpu;int sv=suspended_valid;CPU ssave=suspended_cpu;suspended_valid=0;
 ChildWindow original=child;
 u32 dc=child.dc,modeless=child.modeless;
 int result=call_arm(child.callback,child.handle,message,param,point,500000);
 if((modeless||original.callback==0x300cebbcu)&&result==2&&child.active&&child.handle!=original.handle){
  /* Insufficient gold opens a modal dialogue inside the shop callback.
     Keep that ARM continuation and restore its shop before resuming it. */
  parent_shop=original;parent_shop_valid=1;
  if(original.callback==0x300cebbcu){parent_notebook_cpu=ssave;parent_notebook_valid=sv;}
  /* Paint below the suspended stack, so the modal's draw calls cannot
     overwrite the purchase callback's return addresses. */
  cpu=suspended_cpu;g_error=0;deliver_child();emu_paint();return 1;
 }
 if(child.active&&child.closing){
  child.closing=0;
  call_arm(child.callback,child.handle,0x10u,0,0,500000);
  child.active=0;
 }
 int closed=!child.active;
 cpu=saved;suspended_valid=sv;suspended_cpu=ssave;g_error=0;
 if(closed){
  Obj*o=getobj(dc);if(o)o->kind=0;
  if(!modeless){
   if(parent_shop_valid){child=parent_shop;parent_shop_valid=0;}
   resume_suspended();
   if(parent_notebook_valid){
    suspended_cpu=parent_notebook_cpu;suspended_valid=1;parent_notebook_valid=0;
    if(!child.active){Obj*parent_dc=getobj(parent_shop.dc);if(parent_dc)parent_dc->kind=0;resume_suspended();}
   }
   if(child.active&&child.closing){
    child.closing=0;
    call_arm(child.callback,child.handle,0x10u,0,0,500000);
    Obj*shop_dc=getobj(child.dc);if(shop_dc)shop_dc->kind=0;
    child.active=0;g_error=0;
   }
   if(child.active&&child.pending)deliver_child();
  }
 }
 emu_paint();return 1;
}
static int child_touch(u32 x,u32 y){
 if(!child.active)return 0;
 u32 handle=child.handle;
 child_message(0x201u,0,(y<<16)|x);
 if(child.active&&child.handle==handle)child_message(0x202u,0,(y<<16)|x);
 return 1;
}
static int child_key(u32 key){
 if(!child.active)return 0;
 if(child.callback==0x300cebbcu){
  u32 records=notebook_records();
  if(key==38u||key==37u||key==40u||key==39u){
   i32 step=key==38u?-5:key==40u?5:key==37u?-1:1;
   for(i32 n=1;n<=22;n++){u32 next=(u32)(((i32)child.selection+n*step+110)%22);if(records&(1u<<next)){child.selection=next;break;}}
   emu_paint();return 1;
  }
  if(key==41u&&records)return child_touch((u32)(child.left+17+(i32)(child.selection%5u)*31),(u32)(child.top+10+(i32)(child.selection/5u)*17));
  if(key!=27u&&key!=41u&&key!=78u)return 1;
 }
 if(child.modeless&&child.callback==0x300c9294u){
  if(key==38u||key==37u){child.selection=(child.selection+3u)%4u;emu_paint();return 1;}
  if(key==40u||key==39u){child.selection=(child.selection+1u)%4u;emu_paint();return 1;}
  if(key==27u)return child_touch(120u,183u);
  if(key==41u)return child_touch(120u,108u+25u*child.selection);
  return 1;
 }
 return child_message(WM_KEYDOWN,(key&0xffffu)<<16,0);
}
/* Use the original book command, including its ownership check, rather than
   tapping an inventory slot whose contents depend on the current panel. */
int web_can_checkpoint(void){
 u32 state=mr32(WINDOW+0x58u);
 return emu_mode()==0&&!child.active&&!web_flight_active&&!web_sleep_ms&&state&&mr32(state+0x1du)==1u;
}
int web_book_active(void){return child.active&&child.callback==0x300ce2d0u;}
int web_can_book(void){
 return web_book_active()||web_can_checkpoint()&&(mr32(mr32(WINDOW+0x58u)+0x3du)&1u)!=0;
}
int web_item_owned(u32 slot){
 u32 state=mr32(WINDOW+0x58u);
 return slot<10u&&emu_mode()==0&&state&&(mr32(state+0x3du)&(1u<<(slot+2u)))!=0;
}
u32 web_item_count(u32 slot){
 if(!web_item_owned(slot))return 0;
 return slot==6u?mr32(mr32(WINDOW+0x58u)+0x41u):1u;
}
/* Read-only availability mirrors the original flight item and floor bounds.
   The original map byte array used by 0x300c5070 is at 0x3047214c. */
int web_can_fly(u32 down){
 if(down>1u||!web_can_checkpoint())return 0;
 u32 state=mr32(WINDOW+0x58u),floor=mr32(state+5u),visited=mr32(state+9u);
 if(!(mr32(state+0x3du)&4u)||floor>50u||
    (down?floor<=1u:floor>=50u||floor>=visited))return 0;
 i32 x=(i32)mr32(state+0x76u),y=(i32)mr32(state+0x7au);
 static const i32 dx[]={1,-1,0,0},dy[]={0,0,-1,1};
 for(u32 i=0;i<4u;i++){
  i32 xx=x+dx[i],yy=y+dy[i];if(xx<0||xx>10||yy<0||yy>10)continue;
  u32 tile=mr8(0x3047214cu+(u32)yy*11u+(u32)xx);
  if(tile==6u||tile==7u)return 1;
 }
 return 0;
}
int web_fly(u32 down){
 if(!web_can_fly(down))return 0;
 /* Let the firmware check ownership/proximity and create its menu, then
    choose through the same original command as the native flight popup. */
 int ok=call_arm(0x300cd6ecu,WINDOW,0,0,0,900000);
 if(!ok||!web_flight_active)return 0;
 web_flight_selection=down;web_notice_active=0;return web_flight_choose(0);
}
int web_can_item(u32 slot){
 if(!web_item_owned(slot)||!web_can_checkpoint()||!web_item_count(slot))return 0;
 if(slot==0u)return web_can_fly(0)||web_can_fly(1);
 if(slot==1u){for(u32 i=0;i<121u;i++)if(mr8(0x3047214cu+i)==1u)return 1;return 0;}
 if(slot==6u){u32 state=mr32(WINDOW+0x58u);return mr8(0x3047214cu+(10u-mr32(state+0x7au))*11u+10u-mr32(state+0x76u))==0u;}
 if(slot==7u||slot==8u){
  u32 state=mr32(WINDOW+0x58u),floor=mr32(state+5u);
  if(slot==8u?floor==0u:floor>=50u||floor>=mr32(state+9u))return 0;
  i32 x=(i32)mr32(state+0x76u),y=(i32)mr32(state+0x7au);
  static const i32 dx[]={1,-1,0,0},dy[]={0,0,-1,1};
  for(u32 i=0;i<4u;i++){i32 xx=x+dx[i],yy=y+dy[i];if(xx<0||xx>10||yy<0||yy>10)continue;u32 tile=mr8(0x3047214cu+(u32)yy*11u+(u32)xx);if(tile==6u||tile==7u)return 1;}
  return 0;
 }
 return 1;
}
int web_item_use(u32 slot){
 if(!web_can_item(slot))return 0;
 static const u32 commands[]={0x300cd6ecu,0x300cd3c8u,0x300cd4ccu,0x300cd438u,0x300cd1e8u,0x300cd15cu,0x300cddb0u,0x300cdc40u,0x300cda90u,0x300cd5ccu};
 web_notice_active=0;
 int ok=call_arm(commands[slot],WINDOW,0,0,0,900000);
 deliver_child();emu_paint();return ok!=0;
}
int web_book(void){
 if(web_book_active())return child_key(27u);
 u32 state=mr32(WINDOW+0x58u);
 if(emu_mode()!=0||child.active||web_flight_active||web_sleep_ms||web_combat_active()||
    !state||mr32(state+0x1du)!=1u)return 0;
 int ok=call_arm(0x300ce39cu,WINDOW,0,0,0,900000);
 deliver_child();emu_paint();return ok!=0;
}
